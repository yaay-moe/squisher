# SPDX-License-Identifier: LGPL-2.1-or-later

[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/yaay-moe/squisher/releases/latest/download/
MatchPattern=%M_@v_%a.usr-%a-verity.@u.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v_verity
MatchPartitionType=usr-verity
PartitionFlags=0
ReadOnly=1

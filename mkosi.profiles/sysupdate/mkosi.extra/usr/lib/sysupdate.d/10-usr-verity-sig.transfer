# SPDX-License-Identifier: LGPL-2.1-or-later

[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/yaay-moe/squisher/releases/latest/download/
MatchPattern=%M_@v_%a.usr-%a-verity-sig.@u.raw

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v_verity_sig
MatchPartitionType=usr-verity-sig
PartitionFlags=0
ReadOnly=1
# Temp workaround until systemd 262.2 lands in Fedora 45
PartitionZeroFill=0
